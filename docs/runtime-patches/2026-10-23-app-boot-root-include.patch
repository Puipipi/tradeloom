-const bootstrapIncludes = new WeakMap<Context, Entry>()
+const BOOTSTRAP_INCLUDES_KEY = Symbol.for('@deepseek-ai/dsh-app-boot/bootstrap-includes/v1')
+const bootstrapIncludes = (() => {
+  const existing = Reflect.get(globalThis, BOOTSTRAP_INCLUDES_KEY) as unknown
+  if (existing !== undefined) {
+    if (!(existing instanceof WeakMap)) throw new Error('app-boot: incompatible root Include registry')
+    return existing as WeakMap<Context, Entry>
+  }
+  const registry = new WeakMap<Context, Entry>()
+  Object.defineProperty(globalThis, BOOTSTRAP_INCLUDES_KEY, {
+    configurable: false,
+    enumerable: false,
+    value: registry,
+    writable: false,
+  })
+  return registry
+})()
 
