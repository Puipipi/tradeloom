diff --git a/packages/mesh/src/read-only-policy.ts b/packages/mesh/src/read-only-policy.ts
new file mode 100644
index 0000000..c078a65
--- /dev/null
+++ b/packages/mesh/src/read-only-policy.ts
@@ -0,0 +1,27 @@
+const readCalls = new Set(['session/list'])
+const readStreams = new Set(['workspace/follow', 'session/follow'])
+
+export function permitsReadOnlyMeshRpc(method: string, params: unknown): boolean {
+  switch (method) {
+    case 'harness.transport.describe':
+    case 'harness.remote.stream.close':
+    case 'harness.remote.stream.event':
+      return true
+    case 'harness.remote.call':
+    case 'harness.remote.stream.open': {
+      if (params === null || typeof params !== 'object') return false
+      const endpoint = (params as { endpoint?: unknown }).endpoint
+      return typeof endpoint === 'string' &&
+        (method === 'harness.remote.call' ? readCalls : readStreams).has(endpoint)
+    }
+    default:
+      return false
+  }
+}
+
+export function permitsReadOnlyMeshPeer(
+  prefs: { allowIncoming: boolean; allowedCallers: readonly string[] },
+  deviceId: string,
+): boolean {
+  return prefs.allowIncoming === true && prefs.allowedCallers.includes(deviceId)
+}
