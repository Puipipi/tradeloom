+import { describe, expect, it, vi } from 'vitest'
+import { MeshPeers } from '../src/peers.js'
+
+const { connect } = vi.hoisted(() => ({ connect: vi.fn() }))
+vi.mock('ds-harness-remote/internal', async importOriginal => ({
+  ...await importOriginal<typeof import('ds-harness-remote/internal')>(),
+  ClientConnection: class {
+    connect = connect
+  },
+}))
+
+describe('read-only Mesh peer reconnection', () => {
+  it('drops a stale connection and dials fresh after the next explicit read', async () => {
+    const previous = { close: vi.fn(async () => undefined), onClose: vi.fn() }
+    const next = { close: vi.fn(async () => undefined), onClose: vi.fn() }
+    connect.mockResolvedValueOnce({ client: previous }).mockResolvedValueOnce({ client: next })
+
+    type Inputs = ConstructorParameters<typeof MeshPeers>
+    const server = {
+      listDevices: async () => [{ deviceId: 'host', nodeId: 'selected', name: 'Desktop', platform: 'win32', online: true }],
+    } as unknown as Inputs[2]
+    const peers = new MeshPeers(
+      {} as Inputs[0], {} as Inputs[1], server, {} as Inputs[3], {} as Inputs[4],
+      { info: vi.fn(), warn: vi.fn() } as unknown as Inputs[5],
+      vi.fn(),
+    )
+    await peers.refresh()
+    const gateway = (await peers.connectTo('selected'))!.gateway!
+    peers.invalidateConnection('selected', gateway)
+    expect(peers.peer('selected')).toMatchObject({ status: 'offline', gateway: undefined })
+    expect(previous.close).toHaveBeenCalledOnce()
+    expect(connect).toHaveBeenCalledOnce()
+
+    const reopened = (await peers.connectTo('selected'))!.gateway!
+    expect(reopened).not.toBe(gateway)
+    expect(connect).toHaveBeenCalledTimes(2)
+    peers.invalidateConnection('selected', gateway)
+    expect(peers.peer('selected')?.gateway).toBe(reopened)
+    expect(next.close).not.toHaveBeenCalled()
+    await peers.close()
+  })
+})
