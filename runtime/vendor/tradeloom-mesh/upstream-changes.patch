+  entry: {
+    index: 'src/index.ts',
+  },
+  format: ['esm'],
+  platform: 'node',
+  target: 'node22',
+  outDir: 'bundle-tradeloom',
+  dts: false,
+  clean: true,
+  sourcemap: false,
+  deps: {
+    neverBundle: [/^@deepseek-ai\//, /^node:/, 'werift', '@roamhq/wrtc'],
+    alwaysBundle: [
+      /^ds-harness-remote/,
+      /^@dsh-remote\//,
+      /^@dsh-mesh\//,
+      /^@xterm\//,
+      /^@noble\//,
+      'ws',
+      'zod',
+      'qrcode',
+    ],
+  },
+})
