+import { mkdtemp, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+import { createElectronBuilderConfig } from '../scripts/electron-builder-config.mjs'
+import { desktopTargetBuildPaths } from '../scripts/desktop-build-paths.mjs'
+
+const execFileMock = vi.hoisted(() => vi.fn((...args: any[]) => {
+  const callback = args.at(-1)
+  if (typeof callback === 'function') callback(null, '', '')
+}))
+vi.mock('node:child_process', async importOriginal => ({
+  ...await importOriginal(),
+  execFile: execFileMock,
+}))
+
+const temporaryRoots: string[] = []
+const generatedDefaultIncludes: string[] = []
+afterEach(async () => {
+  for (const include of generatedDefaultIncludes.splice(0)) await rm(include, { force: true })
+  for (const root of temporaryRoots.splice(0)) await rm(root, { recursive: true, force: true })
+  execFileMock.mockClear()
+})
+
+it('quotes NSIS paths with spaces, Unicode, dollar signs, and quotes', async () => {
+  const { quoteNsisPath } = await import('../scripts/desktop-build-paths.mjs')
+  expect(quoteNsisPath).toBeTypeOf('function')
+  expect(quoteNsisPath(String.raw`C:\space dir\织贸助手\$cash\installer"quote.nsh`))
+    .toBe(String.raw`"C:\space dir\织贸助手\$$cash\installer$\"quote.nsh"`)
+})
+
+it.each([false, true])('uses one NSIS installer UI root for default/custom builds (custom=%s)', async customRoot => {
+  const testArea = join(process.cwd(), 'testing')
+  await mkdir(testArea, { recursive: true })
+  const root = await mkdtemp(join(testArea, 'nsis $ root - 织贸助手-'))
+  temporaryRoots.push(root)
+  const stage = join(root, 'stage')
+  await mkdir(stage)
+  await writeFile(join(stage, '.tradeloom-desktop-stage-owned'), 'tradeloom-desktop-stage-v1\n')
+  const env: NodeJS.ProcessEnv = {
+    DSH_DESKTOP_APP_ID: 'cn.tradeloom.workbench',
+    DSH_DESKTOP_TARGET_PLATFORM: 'win32',
+    DSH_DESKTOP_UNSIGNED: '1',
+    TRADELOOM_DESKTOP_STAGE: stage,
+  }
+  if (customRoot) env.TRADELOOM_DESKTOP_BUILD_ROOT = join(root, 'external build $ root', '织贸助手')
+  const paths = desktopTargetBuildPaths('win-x64', env)
+  const config = createElectronBuilderConfig(env, 'win32', 'x64') as {
+    nsis: { include: string }
+    beforeBuild: () => Promise<boolean>
+  }
+  const expectedInclude = join(paths.root, 'tradeloom-installer.nsh')
+  const expectedUi = join(paths.root, 'installer-ui')
+  const script = join(process.cwd(), 'scripts', 'installer.nsh')
+  if (!customRoot) generatedDefaultIncludes.push(expectedInclude)
+  expect(config.nsis.include).toBe(expectedInclude)
+
+  expect(await config.beforeBuild()).toBe(true)
