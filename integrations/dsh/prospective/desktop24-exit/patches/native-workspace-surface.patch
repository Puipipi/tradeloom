+/** Native owner for one embedded Factory occurrence, independent of the main right column. */
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { PaneId, TabId, TabRecord } from '@deepseek-ai/dsh-client-ui-dockkit'
+import type { SidebarRightTabRegistry } from './tab-registry.ts'
+import type { PinResource, TabOccurrence } from './tab-domain.ts'
+import {
+  createSidebarRightController, type SidebarRightController, type SidebarRightHost,
+  type SidebarRightSurfaceStore, type SidebarRightOpenResourceOptions, type SidebarRightOpenTabOptions,
+} from './service.ts'
+
+/**
+ * Owns navigation and resource lifetimes for exactly one renderer-created store.
+ * The enclosing SessionProvider owns its SessionReference; this owner never
+ * changes the global Session selection or releases the caller's reference.
+ */
+export class EmbeddedSidebarOwner {
+  readonly controller: SidebarRightController
+  private readonly releaseStore: () => void
+  private readonly forget: () => void
+  private readonly show: (sessionId: SessionId | undefined) => void
+  private readonly measureStore: (fits: (paneId: PaneId) => boolean) => void
+  private mounts = 0
+  private revision = 0
+  private disposed = false
+
+  /** The framework supplies the real Session id and its occurrence-exclusive store. */
+  constructor(
+    readonly sessionId: SessionId,
+    store: SidebarRightSurfaceStore,
+    tabs: SidebarRightTabRegistry,
+    pin: PinResource,
+    host: SidebarRightHost,
+    private readonly onDispose?: () => void,
+  ) {
+    const surface = createSidebarRightController(tabs, pin, host)
+    this.controller = surface.controller
+    // Adoption belongs inside this native owner, never in the workbench shell.
+    this.releaseStore = surface.adopt(sessionId, store)
+    this.forget = () => { surface.forget(sessionId) }
+    this.show = surface.show
+    this.measureStore = fits => { surface.measure(sessionId, fits) }
+    surface.show(sessionId)
+  }
+
+  /**
+   * Retain one committed Factory root. A synchronous effect replay reuses this
+   * owner; an actual final unmount aborts its occurrences at the next microtask.
+   */
+  retain(): () => void {
+    this.assertLive()
+    this.mounts += 1
+    this.revision += 1
+    let held = true
+    return () => {
+      if (!held) return
+      held = false
+      this.mounts -= 1
+      const revision = ++this.revision
+      queueMicrotask(() => {
+        if (this.mounts === 0 && this.revision === revision) this.dispose()
+      })
+    }
+  }
+
+  /** A kept-mounted body holds its native owner, not the caller's SessionReference. */
+  readonly retainTab = (_tabId: TabId, signal: AbortSignal): (() => void) => {
+    if (signal.aborted) return () => {}
+    const releaseOwner = this.retain()
+    let held = true
+    const release = (): void => {
+      if (!held) return
+      held = false
+      signal.removeEventListener('abort', release)
+      releaseOwner()
+    }
+    signal.addEventListener('abort', release, { once: true })
+    return release
+  }
+
+  /** Open a page in this occurrence, without consulting the main right column. */
+  openTab(kind: string, options?: SidebarRightOpenTabOptions): void {
+    this.assertLive()
+    this.controller.openTabIn(this.sessionId, kind, options)
+  }
+
+  /** Open a resource using this occurrence's real Session workspace. */
+  openResource(address: string, options?: SidebarRightOpenResourceOptions): void {
+    this.assertLive()
+    this.controller.openResourceIn(this.sessionId, address, options)
+  }
+
+  /** Return an existing lifetime, never synthesize a tab record or a pin. */
+  occurrence(tab: Pick<TabRecord, 'id'>): TabOccurrence {
+    this.assertLive()
+    return this.controller.tabDomain.occurrence(this.sessionId, tab)
+  }
+
+  /** Record only this occurrence's measured room for splitting. */
+  measure(fits: (paneId: PaneId) => boolean): void {
+    this.assertLive()
+    this.measureStore(fits)
+  }
+
+  /** End this surface once; other surfaces and the borrowed Session are untouched. */
+  dispose(): void {
+    if (this.disposed) return
+    this.disposed = true
+    this.revision += 1
+    this.show(undefined)
+    // Stop reconciliation before abort handlers can publish cleanup writes.
+    this.releaseStore()
+    this.controller.tabDomain.dispose()
+    this.forget()
+    this.onDispose?.()
+  }
+
+  private assertLive(): void {
+    if (this.disposed) throw new Error('Embedded surface is disposed')
+  }
+}
