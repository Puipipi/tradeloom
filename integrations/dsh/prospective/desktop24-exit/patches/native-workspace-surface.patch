+/** Public session-scoped Factory for a pane-local native file/document surface. */
+import { useCallback, useEffect, useLayoutEffect } from 'react'
+import type { ReactNode } from 'react'
+import { flushSync } from 'react-dom'
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { randomUUID } from '@deepseek-ai/dsh-util-crypto'
+import type { BoundActions, FactoryComponentPropsOf } from '@deepseek-ai/dsh-client-ui-slots'
+import type { HalvesFit, PaneId, TabId } from '@deepseek-ai/dsh-client-ui-dockkit'
+import { createSidebarRightStore } from './stores.ts'
+import { defaultSeed } from './contract/seed.ts'
+import type { SidebarRightTabRegistry } from './tab-registry.ts'
+import { tabInfoFactory } from './tab-info.ts'
+import { EmbeddedSidebarOwner } from './embedded-owner.ts'
+import { SidebarDockSurface, SidebarDockContent, type SidebarRightInjected } from './shell/SidebarRight.tsx'
+
+/** Geometry and window controls belong to the enclosing workbench pane. */
+export interface EmbeddedSidebarInput {
+  readonly ownerId: string
+  readonly active?: boolean
+  readonly initialKind?: string
+}
+
+/** Only the native owner assembles these navigation and lifetime faces. */
+export interface EmbeddedSidebarInjected extends Pick<SidebarRightInjected, 'hooks' | 'keyedHooks' | 'occurrence'> {
+  readonly surfaceOwner: EmbeddedSidebarOwner
+  readonly mountSurface: () => () => void
+  readonly setSurfaceRoot: (node: HTMLDivElement | null) => void
+}
+
+/** Find a pane only inside this Factory root, even if another root shows the same Session. */
+function focusPane(root: HTMLElement, paneId: PaneId): void {
+  const pane = [...root.querySelectorAll<HTMLElement>('[data-dockkit-pane], [data-dockkit-float]')]
+    .find(node => (node.dataset.dockkitPane ?? node.dataset.dockkitFloat) === paneId)
+  if (pane !== undefined && pane.getBoundingClientRect().width > 0) pane.focus({ preventScroll: true })
+}
+
+/** SessionProvider and the renderer supply the true Session generation and store occurrence. */
+export function EmbeddedSidebarSurface(props: FactoryComponentPropsOf<'sidebar.surface'>): ReactNode {
+  const {
+    sessionId, ownerId, active = true, initialKind = 'files', useStore, actions, t,
+    renderFactorySlot, useTabTypes, useTabNavigation, useShortcuts, occurrence,
+    surfaceOwner, mountSurface, setSurfaceRoot,
+  } = props
+  const surface = useStore(state => state.bySession[sessionId])
+  const types = useTabTypes(value => value)
+  const shortcuts = useShortcuts(value => value)
+  useLayoutEffect(mountSurface, [mountSurface])
+  useEffect(() => {
+    if (surface === undefined && types.some(type => type.kind === initialKind)) surfaceOwner.openTab(initialKind)
+  }, [initialKind, surface, surfaceOwner, types])
+  const reportRoom = useCallback((fits: ReadonlyMap<PaneId, HalvesFit>): void => {
+    surfaceOwner.measure(paneId => fits.get(paneId)?.row !== false)
+  }, [surfaceOwner])
+  return <div ref={setSurfaceRoot} data-sidebar-surface-owner={ownerId} data-sidebar-right-session={sessionId}
+    style={{ height: '100%', minHeight: 0, minWidth: 0, position: 'relative' }}>
+    {surface === undefined ? <p role="status">{t('tab.unavailable')}</p> : <SidebarDockSurface
+      sessionId={sessionId} surface={surface} actions={actions} t={t} renderFactorySlot={renderFactorySlot}
+      useStore={useStore} useTabTypes={useTabTypes} useTabNavigation={useTabNavigation} occurrence={occurrence}
+      openTab={(kind, options) => { surfaceOwner.openTab(kind, options) }}
+      closeTab={tabId => { surfaceOwner.controller.closeIn(sessionId, tabId) }}
+      splitPane={paneId => { surfaceOwner.controller.split(paneId) }}
+      fullscreen={false} autoFullscreen={false} reportRoom={reportRoom}
+      active={active} retainTab={surfaceOwner.retainTab} shortcuts={shortcuts} chrome={null}
+    />}
+  </div>
+}
+
+/** Register the Factory over occurrence-exclusive stores; the main right column stays independent. */
+export function registerEmbeddedSidebar(ctx: Context, tabs: SidebarRightTabRegistry): () => void {
+  // The original rightbar calls this same Factory. Children must have one declarer.
+  const disposeContent = ctx.slots.registerFactory({
+    name: 'sidebar.dock.content', scope: 'session',
+    children: {
+      'sidebar.right.pane.tab': { kind: 'keyed', scope: 'session', inject: { hooks: { tabInfo: tabInfoFactory } } },
+      'sidebar.right.pane.tab.title': { kind: 'keyed', scope: 'session', inject: { hooks: { tabInfo: tabInfoFactory } } },
+      'sidebar.right.tab.menu.item': { kind: 'list', scope: 'session' },
+    },
+  }, SidebarDockContent)
+  type Handle = ReturnType<typeof createSidebarRightStore>
+  interface Face { owner: EmbeddedSidebarOwner; setRoot: (node: HTMLDivElement | null) => void }
+  const faces = new WeakMap<BoundActions<Handle>, Face>()
+  const mounted = new Set<EmbeddedSidebarOwner>()
+  const createStore = (): Handle => {
+    const handle = createSidebarRightStore(() => defaultSeed(tabs), { persistLayout: false, idNamespace: `surface-${randomUUID()}` })
+    return { ...handle, create(scopeKey) {
+      if (scopeKey === undefined) throw new Error('Embedded surface requires a SessionProvider')
+      const instance = handle.create(scopeKey), sessionId = scopeKey as SessionId
+      let root: HTMLDivElement | null = null
+      const owner = new EmbeddedSidebarOwner(sessionId, instance, tabs, (address, signal) => {
+        ctx.resources.pin(address, signal)
+      }, {
+        autoFullscreen: () => false,
+        openWithFocus: (_id, open) => {
+          if (root === null || !root.contains(root.ownerDocument.activeElement)) { open(); return }
+          let pane: PaneId | undefined
+          flushSync(() => { pane = open() })
+          if (pane !== undefined) focusPane(root, pane)
+        },
+        closeWithFocus: (_id, paneId, close) => {
+          const retain = root !== null && root.contains(root.ownerDocument.activeElement)
+          flushSync(close)
+          if (retain && root !== null) focusPane(root, paneId)
+        },
+      }, () => { mounted.delete(owner) })
+      const face: Face = { owner, setRoot: node => { root = node } }
+      faces.set(instance.actions, face)
+      return instance
+    } }
+  }
+  const dispose = ctx.slots.registerFactory({
+    name: 'sidebar.surface', scope: 'session', locale: 'sidebarRight', store: createStore,
+    inject: (sessionId, actions): EmbeddedSidebarInjected => {
+      const face = faces.get(actions)
+      if (face === undefined || face.owner.sessionId !== sessionId) throw new Error('Embedded surface store binding is unavailable')
+      const owner = face.owner
+      return {
+        surfaceOwner: owner,
+        mountSurface: () => { mounted.add(owner); return owner.retain() },
+        setSurfaceRoot: face.setRoot,
+        occurrence: tab => owner.occurrence(tab),
+        hooks: { shortcuts: ctx.shortcuts.catalog, tabTypes: { subscribe: listener => tabs.subscribe(listener), getSnapshot: () => tabs.entries() } },
+        keyedHooks: { tabNavigation: key => owner.occurrence({ id: key as TabId }).navigation },
+      }
+    },
+  }, EmbeddedSidebarSurface)
+  return () => { dispose(); for (const owner of mounted) owner.dispose(); mounted.clear(); disposeContent() }
+}
