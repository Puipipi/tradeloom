diff --git a/packages/client/ui-primitives/tests/secondary-window.client.spec.tsx b/packages/client/ui-primitives/tests/secondary-window.client.spec.tsx
new file mode 100644
index 0000000..22d0199
--- /dev/null
+++ b/packages/client/ui-primitives/tests/secondary-window.client.spec.tsx
@@ -0,0 +0,166 @@
+// @vitest-environment jsdom
+/** Same-origin secondary-window ownership for anchored popovers. */
+import { createPortal } from 'react-dom'
+import { act, cleanup, fireEvent, render, waitFor } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { Menu } from '../src/Menu.tsx'
+import { Tooltip } from '../src/Tooltip.tsx'
+import { HoverCard } from '../src/HoverCard.tsx'
+import { isElementInDocument, isHTMLElementInDocument, isNodeInDocument } from '../src/owner-document.ts'
+import { OWNER_DOCUMENT_CHANGE_EVENT, OWNER_DOCUMENT_ROOT_ATTRIBUTE } from '../src/owner-document.ts'
+
+afterEach(cleanup)
+
+function makeSecondaryDocument(): { iframe: HTMLIFrameElement; document: Document } {
+  const iframe = document.createElement('iframe')
+  document.body.append(iframe)
+  const childDocument = iframe.contentDocument
+  if (childDocument === null) throw new Error('jsdom iframe did not create a document')
+  return { iframe, document: childDocument }
+}
+
+it('uses the secondary document portal, viewport, focus and keyboard listeners for menus', async () => {
+  const { iframe, document: childDocument } = makeSecondaryDocument()
+  const target = childDocument.createElement('div')
+  childDocument.body.append(target)
+  const onClose = vi.fn()
+  const view = render(createPortal(
+    <Menu open portal autoFocus anchor={<button>Open menu</button>}
+      items={[{ id: 'one', label: 'One' }]} onClose={onClose} />,
+    target,
+  ))
+
+  const menu = childDocument.querySelector('[role="menu"]')
+  expect(menu).not.toBeNull()
+  expect(document.querySelector('[role="menu"]')).toBeNull()
+  expect(childDocument.querySelector('[data-menu-backing]')).not.toBeNull()
+  expect(document.querySelector('[data-menu-backing]')).toBeNull()
+  fireEvent.pointerDown(childDocument.body)
+  expect(onClose).toHaveBeenCalledTimes(1)
+  fireEvent.keyDown(childDocument, { key: 'Escape' })
+  expect(onClose).toHaveBeenCalledTimes(2)
+  view.unmount()
+  iframe.remove()
+})
+
+it('portals tooltips into their anchor document and handles its Escape key there', async () => {
+  const { iframe, document: childDocument } = makeSecondaryDocument()
+  const target = childDocument.createElement('div')
+  childDocument.body.append(target)
+  const view = render(createPortal(<Tooltip portal label="Tip" openOnClick><button>Tooltip anchor</button></Tooltip>, target))
+  const tooltipAnchor = childDocument.querySelector('button')!
+
+  fireEvent.click(tooltipAnchor)
+  await waitFor(() => expect(childDocument.querySelector('[role="tooltip"]')).not.toBeNull())
+  expect(document.querySelector('[role="tooltip"]')).toBeNull()
+  fireEvent.keyDown(childDocument, { key: 'Escape' })
+  await waitFor(() => expect(childDocument.querySelector('[role="tooltip"]')).toBeNull())
+  view.unmount()
+  iframe.remove()
+})
+
+it('portals hover cards into their anchor document and handles its Escape key there', async () => {
+  const { iframe, document: childDocument } = makeSecondaryDocument()
+  const target = childDocument.createElement('div')
+  childDocument.body.append(target)
+  const view = render(createPortal(<HoverCard anchor={<button>Hover anchor</button>}
+    content={<span>Preview body</span>} openDelayMs={0} variant="preview" />, target))
+  const anchor = childDocument.querySelector('button')!
+  fireEvent.pointerEnter(anchor.parentElement!)
+  await waitFor(() => expect(childDocument.body.textContent).toContain('Preview body'))
+  expect(document.body.textContent).not.toContain('Preview body')
+  fireEvent.keyDown(childDocument, { key: 'Escape' })
+  await waitFor(() => expect(childDocument.body.textContent).not.toContain('Preview body'))
+  view.unmount()
+  iframe.remove()
+})
+
+it('recognizes DOM elements using the owning window constructors', () => {
+  const { iframe, document: childDocument } = makeSecondaryDocument()
+  const element = childDocument.createElement('button')
+  expect(isNodeInDocument(element, childDocument)).toBe(true)
+  expect(isElementInDocument(element, childDocument)).toBe(true)
+  expect(isHTMLElementInDocument(element, childDocument)).toBe(true)
+  expect(isNodeInDocument(element, document)).toBe(false)
+  expect(isElementInDocument(element, document)).toBe(false)
+  expect(isHTMLElementInDocument(element, document)).toBe(false)
+  iframe.remove()
+})
+
+it('rebinds a mounted menu and its portal after its panel host is adopted into another document', async () => {
+  const { iframe, document: childDocument } = makeSecondaryDocument()
+  const panelHost = document.createElement('div')
+  document.body.append(panelHost)
+  const onClose = vi.fn()
+  const view = render(createPortal(
+    <Menu open={false} portal anchor={<button>Open menu</button>} items={[{ id: 'one', label: 'One' }]} onClose={onClose} />,
+    panelHost,
+  ))
+  const root = panelHost.querySelector(`[${OWNER_DOCUMENT_ROOT_ATTRIBUTE}]`)
+  expect(root).not.toBeNull()
+
+  childDocument.body.append(panelHost)
+  await act(async () => { root!.dispatchEvent(new childDocument.defaultView!.Event(OWNER_DOCUMENT_CHANGE_EVENT)) })
+  view.rerender(createPortal(
+    <Menu open portal anchor={<button>Open menu</button>} items={[{ id: 'one', label: 'One' }]} onClose={onClose} />,
+    panelHost,
+  ))
+  await waitFor(() => expect(childDocument.querySelector('[role="menu"]')).not.toBeNull())
+  expect(document.querySelector('[role="menu"]')).toBeNull()
+  document.body.append(panelHost)
+  await act(async () => { root!.dispatchEvent(new document.defaultView!.Event(OWNER_DOCUMENT_CHANGE_EVENT)) })
+  await waitFor(() => expect(document.querySelector('[role="menu"]')).not.toBeNull())
+  expect(childDocument.querySelector('[role="menu"]')).toBeNull()
+  fireEvent.pointerDown(document.body)
+  expect(onClose).toHaveBeenCalledTimes(1)
+
+  view.unmount()
+  iframe.remove()
+})
+
+it('rebinds a mounted tooltip anchor and Escape listener after panel adoption', async () => {
+  const { iframe, document: childDocument } = makeSecondaryDocument()
+  const panelHost = document.createElement('div')
+  document.body.append(panelHost)
+  const view = render(createPortal(
+    <Tooltip portal openOnClick label="Tip"><button>Tooltip anchor</button></Tooltip>,
+    panelHost,
+  ))
+  const anchor = panelHost.querySelector(`[${OWNER_DOCUMENT_ROOT_ATTRIBUTE}]`)
+  expect(anchor).not.toBeNull()
+
+  childDocument.body.append(panelHost)
+  await act(async () => { anchor!.dispatchEvent(new childDocument.defaultView!.Event(OWNER_DOCUMENT_CHANGE_EVENT)) })
+  fireEvent.click(anchor!)
+  await waitFor(() => expect(childDocument.querySelector('[role="tooltip"]')).not.toBeNull())
+  expect(document.querySelector('[role="tooltip"]')).toBeNull()
+  fireEvent.keyDown(childDocument, { key: 'Escape' })
+  await waitFor(() => expect(childDocument.querySelector('[role="tooltip"]')).toBeNull())
+
+  view.unmount()
+  iframe.remove()
+})
+
+it('rebinds a mounted hover card anchor and Escape listener after panel adoption', async () => {
+  const { iframe, document: childDocument } = makeSecondaryDocument()
+  const panelHost = document.createElement('div')
+  document.body.append(panelHost)
+  const view = render(createPortal(
+    <HoverCard anchor={<button>Hover anchor</button>} content={<span>Preview body</span>}
+      openDelayMs={0} variant="preview" />,
+    panelHost,
+  ))
+  const root = panelHost.querySelector(`[${OWNER_DOCUMENT_ROOT_ATTRIBUTE}]`)
+  expect(root).not.toBeNull()
+
+  childDocument.body.append(panelHost)
+  await act(async () => { root!.dispatchEvent(new childDocument.defaultView!.Event(OWNER_DOCUMENT_CHANGE_EVENT)) })
+  fireEvent.pointerEnter(root!)
+  await waitFor(() => expect(childDocument.body.textContent).toContain('Preview body'))
+  expect(document.body.textContent).not.toContain('Preview body')
+  fireEvent.keyDown(childDocument, { key: 'Escape' })
+  await waitFor(() => expect(childDocument.body.textContent).not.toContain('Preview body'))
+
+  view.unmount()
+  iframe.remove()
+})
