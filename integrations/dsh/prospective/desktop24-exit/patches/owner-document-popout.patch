--- /dev/null
+++ b/packages/client/ui-conversation/tests/secondary-window-owner-document.client.spec.tsx
@@ -0,0 +0,43 @@
+// @vitest-environment jsdom
+/** Mounted composer roots retain their Lexical editor while their panel host moves between documents. */
+import { act, cleanup, render } from '@testing-library/react'
+import { createPortal } from 'react-dom'
+import { afterEach, expect, it } from 'vitest'
+import { $createParagraphNode, $createTextNode, $getRoot, createEditor } from 'lexical'
+import { ComposerContentEditable, COMPOSER_OWNER_DOCUMENT_CHANGE_EVENT } from '../src/client/input/editor/ComposerContentEditable.tsx'
+
+afterEach(cleanup)
+
+it('rebinds the mounted Lexical root in both directions without changing its DOM node or editor state', async () => {
+  const iframe = document.createElement('iframe')
+  document.body.append(iframe)
+  const childDocument = iframe.contentDocument!
+  const panelHost = document.createElement('div')
+  document.body.append(panelHost)
+  const editor = createEditor({
+    namespace: 'secondary-window-owner-document-test',
+    onError(error) { throw error },
+  })
+  editor.update(() => {
+    $getRoot().append($createParagraphNode().append($createTextNode('客户生产要求草稿')))
+  }, { discrete: true })
+  const initialState = editor.getEditorState()
+  const view = render(createPortal(<ComposerContentEditable editor={editor} editable />, panelHost))
+  const root = panelHost.querySelector<HTMLElement>('[data-composer-input]')!
+  expect(editor.getRootElement()).toBe(root)
+
+  childDocument.body.append(panelHost)
+  await act(async () => { root.dispatchEvent(new childDocument.defaultView!.Event(COMPOSER_OWNER_DOCUMENT_CHANGE_EVENT)) })
+  expect(editor.getRootElement()).toBe(root)
+  expect(editor.getEditorState()).toBe(initialState)
+
+  document.body.append(panelHost)
+  await act(async () => { root.dispatchEvent(new document.defaultView!.Event(COMPOSER_OWNER_DOCUMENT_CHANGE_EVENT)) })
+  expect(editor.getRootElement()).toBe(root)
+  expect(editor.getEditorState()).toBe(initialState)
+  expect(root.ownerDocument).toBe(document)
+
+  view.unmount()
+  editor.setRootElement(null)
+  iframe.remove()
+})
