diff --git a/packages/client/ui-primitives/src/owner-document.ts b/packages/client/ui-primitives/src/owner-document.ts
new file mode 100644
index 0000000..a0394cd
--- /dev/null
+++ b/packages/client/ui-primitives/src/owner-document.ts
@@ -0,0 +0,40 @@
+/** DOM realm helpers for components rendered into secondary same-origin windows. */
+
+/** Shell dispatches this on marked roots after Dockview moves a panel between windows. */
+export const OWNER_DOCUMENT_CHANGE_EVENT = 'dsh:composer-owner-document-change'
+/** Only explicit UI roots that own document-scoped listeners receive migration notifications. */
+export const OWNER_DOCUMENT_ROOT_ATTRIBUTE = 'data-dsh-owner-document-root'
+
+/** Return the node's document, falling back to the primary document for non-node values. */
+export function ownerDocumentOf(node: Node | null | undefined): Document {
+  return node?.ownerDocument ?? document
+}
+
+/** Return the window that owns a document, with the primary window as a detached-document fallback. */
+export function ownerWindowOf(document: Document): Window & typeof globalThis {
+  return document.defaultView ?? window
+}
+
+/** Cross-realm-safe Node check against the DOM owner of the listener. */
+export function isNodeInDocument(value: EventTarget | null, document: Document): value is Node {
+  const NodeConstructor = document.defaultView?.Node
+  return NodeConstructor !== undefined && value instanceof NodeConstructor
+}
+
+/** Cross-realm-safe Element check against the DOM owner of the listener. */
+export function isElementInDocument(value: EventTarget | null, document: Document): value is Element {
+  const ElementConstructor = document.defaultView?.Element
+  return ElementConstructor !== undefined && value instanceof ElementConstructor
+}
+
+/** Cross-realm-safe HTMLElement check against the DOM owner of the listener. */
+export function isHTMLElementInDocument(value: EventTarget | null, document: Document): value is HTMLElement {
+  const HTMLElementConstructor = document.defaultView?.HTMLElement
+  return HTMLElementConstructor !== undefined && value instanceof HTMLElementConstructor
+}
+
+/** Cross-realm-safe iframe check against the DOM owner of the listener. */
+export function isIFrameInDocument(value: EventTarget | null, document: Document): value is HTMLIFrameElement {
+  const IFrameConstructor = document.defaultView?.HTMLIFrameElement
+  return IFrameConstructor !== undefined && value instanceof IFrameConstructor
+}
