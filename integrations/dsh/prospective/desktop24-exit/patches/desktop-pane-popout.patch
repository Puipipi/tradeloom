+/** Exact inert document used as Dockview's same-origin desktop pane popout target. */
+export const DESKTOP_PANE_POPOUT_PATH = '/desktop-pane-popout.html'
+const DESKTOP_PANE_POPOUT_URL = `dsh-app://app${DESKTOP_PANE_POPOUT_PATH}`
+const DESKTOP_PANE_POPOUT_TICKET = /^[A-Za-z0-9_-]{43}$/u
+const DESKTOP_PANE_POPOUT_HTML = '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>织贸助手</title></head><body></body></html>'
+const DESKTOP_PANE_POPOUT_CSP = "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; frame-src 'self'; media-src 'self' data: blob:"
+
+/** Parse the one-use ticket URL without exposing or logging the ticket elsewhere. */
+export function parseDesktopPanePopoutUrl(value: string): string | undefined {
+  try {
+    const url = new URL(value)
+    if (url.protocol !== 'dsh-app:' || url.hostname !== 'app' || url.port !== ''
+      || url.username !== '' || url.password !== '' || url.pathname !== DESKTOP_PANE_POPOUT_PATH
+      || url.hash !== '') return undefined
+    const entries = [...url.searchParams.entries()]
+    if (entries.length !== 1 || entries[0]?.[0] !== 'ticket') return undefined
+    const ticket = entries[0][1]
+    if (!DESKTOP_PANE_POPOUT_TICKET.test(ticket) || url.href !== `${DESKTOP_PANE_POPOUT_URL}?ticket=${ticket}`) return undefined
+    return ticket
+  } catch { return undefined }
+}
+
+export function isDesktopPanePopoutDocumentUrl(value: string): boolean {
+  return parseDesktopPanePopoutUrl(value) !== undefined
+}
+
+/** Strip an ephemeral ticket before persisting a Dockview layout. */
+export function canonicalDesktopPanePopoutUrl(value: string): string {
+  return isDesktopPanePopoutDocumentUrl(value) ? DESKTOP_PANE_POPOUT_URL : value
+}
+
+/** Short-lived, owner-bound tickets; the ticket is consumed by authorizeOpen, then its allow record is correlated once to Electron did-create-window. */
+export function createDesktopPanePopoutTicketStore(options: { now?: () => number; ttlMs?: number } = {}) {
+  const now = options.now ?? Date.now
+  const ttlMs = options.ttlMs ?? 15_000
+  const issued = new Map<string, { owner: object; expiresAt: number }>()
+  const approved = new Map<string, { owner: object; expiresAt: number }>()
+  const purgeExpired = (): void => {
+    const time = now()
+    for (const tickets of [issued, approved]) {
+      for (const [ticket, entry] of tickets) if (time >= entry.expiresAt) tickets.delete(ticket)
+    }
+  }
+  return {
+    issue(owner: object): string {
+      purgeExpired()
+      const ticket = randomBytes(32).toString('base64url')
+      issued.set(ticket, { owner, expiresAt: now() + ttlMs })
+      return `${DESKTOP_PANE_POPOUT_URL}?ticket=${ticket}`
+    },
+    authorizeOpen(owner: object, value: string): boolean {
+      purgeExpired()
+      const ticket = parseDesktopPanePopoutUrl(value)
+      if (ticket === undefined) return false
+      const entry = issued.get(ticket)
+      if (entry === undefined || entry.owner !== owner) return false
+      issued.delete(ticket)
+      approved.set(ticket, entry)
+      return true
+    },
+    confirmCreatedChild(owner: object, value: string): boolean {
+      purgeExpired()
+      const ticket = parseDesktopPanePopoutUrl(value)
+      if (ticket === undefined) return false
+      const entry = approved.get(ticket)
+      if (entry === undefined || entry.owner !== owner) return false
+      approved.delete(ticket)
+      return true
+    },
+    clearOwner(owner: object): void {
+      for (const tickets of [issued, approved]) {
+        for (const [ticket, entry] of tickets) if (entry.owner === owner) tickets.delete(ticket)
+      }
+    },
+  }
+}
+
+/** Register the narrow pane-popout URL IPC while keeping primary-frame authorization at the caller. */
+export function registerDesktopPanePopoutUrlHandler<T extends { sender: object }>(
+  ipcMain: { handle(channel: string, listener: (event: T) => string): void },
+  channel: string,
+  tickets: ReturnType<typeof createDesktopPanePopoutTicketStore>,
+  assertTrustedPrimaryFrame: (event: T) => void,
+): void {
+  ipcMain.handle(channel, event => {
+    assertTrustedPrimaryFrame(event)
+    return tickets.issue(event.sender)
+  })
+}
+
+/** Classify navigations from a constrained popout; only its ticketed blank page may be top-level. */
+export function desktopPanePopoutNavigation(urlValue: string, isMainFrame: boolean): 'allow' | 'external' | 'deny' {
+  try {
+    const url = new URL(urlValue)
+    if (!isMainFrame) return url.protocol === 'dsh-app:' && url.hostname === 'app' && url.port === ''
+      && url.username === '' && url.password === '' ? 'allow' : 'deny'
+    if (url.protocol === 'http:' || url.protocol === 'https:') return 'external'
+    return isDesktopPanePopoutDocumentUrl(urlValue) ? 'allow' : 'deny'
+  } catch { return 'deny' }
+}
+
+/** Serve the empty same-origin document after the opener has consumed its one-use ticket. */
+export function serveDesktopPanePopoutDocument(request: Request): Response {
+  if (!['GET', 'HEAD'].includes(request.method)) return new Response(null, { status: 405 })
+  let url: URL
+  try { url = new URL(request.url) } catch { return new Response(null, { status: 400 }) }
+  if (url.protocol !== 'dsh-app:' || url.hostname !== 'app' || url.port !== ''
+    || url.username !== '' || url.password !== '' || !isDesktopPanePopoutDocumentUrl(request.url)) return new Response(null, { status: 404 })
+  return new Response(request.method === 'HEAD' ? null : DESKTOP_PANE_POPOUT_HTML, {
+    headers: {
+      'content-type': 'text/html; charset=utf-8',
+      'content-security-policy': DESKTOP_PANE_POPOUT_CSP,
+      'cache-control': 'no-store',
+      'x-content-type-options': 'nosniff',
+    },
+  })
+}
