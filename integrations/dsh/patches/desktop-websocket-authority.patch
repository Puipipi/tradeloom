+import { describe, expect, it } from 'vitest'
+import { desktopWebSocketRequestHeaders } from '../src/websocket-authority.ts'
+
+const request = (overrides: Record<string, unknown> = {}) => desktopWebSocketRequestHeaders({
+  url: 'ws://192.168.1.23:3088/stream', requestHeaders: { Origin: 'dsh-app://app', 'Sec-WebSocket-Protocol': 'dsh' },
+  webContentsId: 4, primaryWebContentsId: 4, hostUrl: 'http://192.168.1.23:3088', hostCookie: 'native=secret', ...overrides,
+} as Parameters<typeof desktopWebSocketRequestHeaders>[0])
+
+describe('desktop websocket authority', () => {
+  it('forwards only the exact LAN authority and desktop origin', () => {
+    expect(request()).toMatchObject({ requestHeaders: { origin: 'http://192.168.1.23:3088', cookie: 'native=secret' } })
+    expect(request({ url: 'ws://192.168.1.24:3088/stream' })).toEqual({})
+    expect(request({ url: 'wss://192.168.1.23:3088/stream' })).toEqual({})
+    expect(request({ webContentsId: 5 })).toEqual({})
+    expect(request({ requestHeaders: { Origin: 'https://attacker.example' } })).toEqual({ cancel: true })
+  })
+})
