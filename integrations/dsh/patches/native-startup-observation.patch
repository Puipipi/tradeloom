diff --git a/apps/desktop/src/startup-observation.ts b/apps/desktop/src/startup-observation.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/startup-observation.ts
@@ -0,0 +1,54 @@
+/** Optional local startup spans. Observation must never decide application control flow. */
+import { appendFileSync } from 'node:fs'
+import { isAbsolute } from 'node:path'
+
+const STAGES = ['backend-start', 'backend-state', 'host-ready-ipc', 'host-close', 'authenticate',
+  'initial-window', 'initial-window-workspace', 'initial-window-welcome', 'navigate', 'window-show'] as const
+const STATUSES = ['begin', 'end', 'error', 'starting', 'ready', 'skipped'] as const
+type Stage = typeof STAGES[number]
+type Status = typeof STATUSES[number]
+interface WindowFields {
+  windowId?: number
+  windowCount?: number
+  visible?: boolean
+  minimized?: boolean
+  destroyed?: boolean
+  exitCode?: number | null
+}
+
+/** A missing or non-local absolute path disables the sink; write errors stay on the observation side. */
+export function createStartupObservation(path?: string,
+  append: (path: string, content: string) => void = (file, content) => { appendFileSync(file, content, { mode: 0o600, flag: 'a' }) },
+): (stage: Stage, status: Status, fields?: WindowFields) => void {
+  const enabled = typeof path === 'string' && isAbsolute(path) && !/^[\\/]{2}/u.test(path)
+  return (stage, status, fields = {}) => {
+    if (!enabled || !STAGES.includes(stage) || !STATUSES.includes(status)) return
+    try {
+      const safe: Record<string, number | boolean | null> = {}
+      for (const key of ['windowId', 'windowCount'] as const) {
+        const value = fields[key]
+        if (typeof value === 'number' && Number.isSafeInteger(value) && value >= 0) safe[key] = value
+      }
+      for (const key of ['visible', 'minimized', 'destroyed'] as const) {
+        if (typeof fields[key] === 'boolean') safe[key] = fields[key]
+      }
+      if (fields.exitCode === null || (typeof fields.exitCode === 'number' && Number.isSafeInteger(fields.exitCode))) safe.exitCode = fields.exitCode
+      append(path, `${JSON.stringify({ stage, pid: process.pid, time: new Date().toISOString(), status, ...safe })}\n`)
+    } catch { /* The original startup result or exception retains ownership. */ }
+  }
+}
+
+export const observeStartup = createStartupObservation(process.env.DSH_DESKTOP_STARTUP_LOG_PATH)
+
+/** Reading window metadata is also a side observation and cannot throw into show(). */
+export function observeStartupWindow(window: {
+  readonly id: number
+  isVisible(): boolean
+  isMinimized(): boolean
+  isDestroyed(): boolean
+}, count: () => number): void {
+  try {
+    observeStartup('window-show', 'end', { windowId: window.id, windowCount: count(),
+      visible: window.isVisible(), minimized: window.isMinimized(), destroyed: window.isDestroyed() })
+  } catch { /* Window ownership and lifecycle remain with the caller. */ }
+}
