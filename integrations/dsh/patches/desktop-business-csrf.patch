diff --git a/apps/desktop/src/web-document.ts b/apps/desktop/src/web-document.ts
index a74ea7c7..d511a6e0 100644
--- a/apps/desktop/src/web-document.ts
+++ b/apps/desktop/src/web-document.ts
@@ -64,6 +64,10 @@ const WITHHELD_RESPONSE_HEADERS = [
 /** Host routes whose responses carry immutable cache headers keyed by a per-process revision. */
 const PLUGIN_BUNDLE_PATH = /^\/plugins\//u
 
+/** CSRF tokens scoped to the authenticated Host authority and this process. */
+const BUSINESS_CSRF_COOKIE = new Map<string, string>()
+const BUSINESS_PATH = /^\/(?:business|business-api|business-static|business-media)(?:\/|$)/u
+
 /**
  * Forward local application requests to its authenticated Host, preserving streaming and cancellation.
  * Plugin bundle responses lose their `cache-control` for `no-store`: the Host marks them immutable
@@ -81,13 +85,28 @@ export async function forwardWebRequest(request: Request, host: string, cookie:
   const target = new URL(host)
   target.pathname = source.pathname
   target.search = source.search
+  const businessRequest = BUSINESS_PATH.test(source.pathname)
   const headers = new Headers(request.headers)
   for (const name of ['host', 'origin', 'cookie', 'sec-fetch-site']) headers.delete(name)
-  headers.set('cookie', cookie)
+  const csrfCookie = businessRequest ? BUSINESS_CSRF_COOKIE.get(target.origin) : undefined
+  headers.set('cookie', [cookie, csrfCookie].filter(Boolean).join('; '))
+  if (businessRequest && ['POST', 'PUT', 'PATCH', 'DELETE'].includes(request.method)) headers.set('origin', target.origin)
   const init = { method: request.method, headers, body: request.body, signal: request.signal, duplex: 'half', redirect: 'manual' as const }
   const response = await fetch(target, init)
   const outgoing = new Headers(response.headers)
+  let rendererCsrfCookie: string | undefined
+  if (businessRequest) {
+    const setCookies = response.headers.getSetCookie()
+    for (const setCookie of setCookies) {
+      const match = /^csrftoken=([^;]+)/iu.exec(setCookie)
+      if (match) {
+        BUSINESS_CSRF_COOKIE.set(target.origin, `csrftoken=${match[1]}`)
+        rendererCsrfCookie = `csrftoken=${match[1]}; Path=/; SameSite=Strict`
+      }
+    }
+  }
   for (const name of WITHHELD_RESPONSE_HEADERS) outgoing.delete(name)
+  if (rendererCsrfCookie !== undefined) outgoing.append('set-cookie', rendererCsrfCookie)
   if (PLUGIN_BUNDLE_PATH.test(source.pathname)) outgoing.set('cache-control', 'no-store')
   return new Response(response.body, { status: response.status, headers: outgoing })
 }
diff --git a/apps/desktop/tests/web-document.spec.ts b/apps/desktop/tests/web-document.spec.ts
index 0fd9b591..63f101c6 100644
--- a/apps/desktop/tests/web-document.spec.ts
+++ b/apps/desktop/tests/web-document.spec.ts
@@ -86,3 +86,22 @@ it('refuses another page origin without forwarding its request', async () => {
   expect(response.status).toBe(403)
   expect(fetch).not.toHaveBeenCalled()
 })
+
+it('bridges Django CSRF only across the business aliases and keeps Host auth cookies private', async () => {
+  const fetch = vi.fn()
+    .mockResolvedValueOnce(new Response('form', { headers: { 'set-cookie': 'csrftoken=csrf-value; Path=/; SameSite=Lax' } }))
+    .mockResolvedValueOnce(new Response('saved', { headers: { 'set-cookie': 'session=host-secret; HttpOnly' } }))
+  vi.stubGlobal('fetch', fetch)
+  const get = await forwardWebRequest(new Request('dsh-app://app/business/', { headers: { origin: 'dsh-app://app' } }), 'http://127.0.0.1:1234/', 'session=owned')
+  expect(get.headers.getSetCookie()).toEqual(['csrftoken=csrf-value; Path=/; SameSite=Strict'])
+  const post = await forwardWebRequest(new Request('dsh-app://app/business-api/save', {
+    method: 'POST', headers: { origin: 'dsh-app://app', 'x-csrftoken': 'csrf-value' }, body: 'x=1',
+  }), 'http://127.0.0.1:1234/', 'session=owned')
+  const [, init] = fetch.mock.calls[1] as [URL, RequestInit]
+  const headers = new Headers(init.headers)
+  expect(headers.get('cookie')).toBe('session=owned; csrftoken=csrf-value')
+  expect(headers.get('origin')).toBe('http://127.0.0.1:1234')
+  expect(headers.get('x-csrftoken')).toBe('csrf-value')
+  expect(post.headers.get('set-cookie')).toBeNull()
+  expect(fetch.mock.calls[0]?.[0]).toBeInstanceOf(URL)
+})
