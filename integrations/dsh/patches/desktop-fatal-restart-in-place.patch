+/** Restart the backend without letting Electron's quit hooks own the child lifetime. */
+export async function restartBackendInPlaceWithShutdownGuard(
+  setShuttingDown: (value: boolean) => void,
+  stopBackend: () => Promise<void>,
+  startBackend: () => Promise<void>,
+): Promise<void> {
+  setShuttingDown(true)
+  try {
+    await stopBackend()
+  } finally {
+    setShuttingDown(false)
+  }
+  await startBackend()
+}
