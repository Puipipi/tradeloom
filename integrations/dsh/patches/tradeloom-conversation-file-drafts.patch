+  addDraftFiles(files: readonly File[]): boolean {
+    const sessionId = this.scopeId('addDraftFiles')
+    if (files.length === 0) return true
+    if (this.requireSessions().binding(sessionId) === undefined) return false
+    const input = this.input.for(this.ctx)
+    const phase = input.state.getSnapshot().phase
+    if (phase === 'adjudicating' || phase === 'submitting') return false
+    const drafts = this.createDrafts(sessionId, files)
+    if (input.addAttachments(drafts.map(draft => draft.id))) return true
+    this.releaseDraftAttachments(drafts)
+    return false
   }
 
