+export interface DesktopAiWebRequest { readonly provider: 'deepseek' }
+
+/** Non-secret state of the independently owned persistent webpage window. */
+export interface DesktopAiWebState {
+  readonly provider: 'deepseek'
+  readonly available: true
+  readonly open: boolean
+  readonly visible: boolean
+  readonly phase: 'closed' | 'loading' | 'ready' | 'error'
+  readonly error: 'page_load_failed' | 'page_process_stopped' | null
+  readonly persistentSession: true
+  readonly origin: string | null
+}
+
+/** File dialog result; delivery is not evidence the remote website parsed a file. */
+export interface DesktopAiWebFileResult {
+  readonly cancelled: boolean
+  readonly name?: string
+  readonly bytes?: number
+  readonly delivered?: true
+  readonly websiteConfirmed?: false
+  readonly saved?: true
+}
